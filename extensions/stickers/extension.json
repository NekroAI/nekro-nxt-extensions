{
  "id": "ext_7T93Z3095PRF7PRDP39TCREGC4",
  "slug": "stickers",
  "displayName": "Emotion 表情包",
  "description": "让智能体用表情包表达情绪：自动收集群里大家常发的表情包，回复时挑一张合适的发出。公共表情包在各个频道共享，已有的表情包可以批量导入。",
  "createdAt": 1791660757053,
  "requires": {
    "sdk": 11
  },
  "clientCss": "assets/client.module.css",
  "permissions": {
    "permissions": ["channels.read", "agents.read"],
    "networkOrigins": [],
    "host": {
      "storage": {
        "quotaBytes": 33554432
      },
      "assets": {
        "library": {}
      },
      "index": {
        "collections": [
          {
            "name": "stickers",
            "fields": [
              {
                "name": "meaning",
                "weight": 2
              },
              {
                "name": "caption",
                "weight": 1.5
              },
              {
                "name": "description",
                "weight": 1
              },
              {
                "name": "tags",
                "weight": 1
              }
            ],
            "filters": ["scope", "sources", "collector"]
          }
        ]
      },
      "models": {
        "maxCallsPerMinute": 60,
        "maxOutputTokens": 1024
      }
    },
    "agent": {
      "assets": {
        "library": {}
      },
      "context": [
        {
          "name": "guide",
          "kind": "static",
          "maxChars": 1600
        }
      ],
      "inboundHook": {
        "reads": "all",
        "mayHide": false,
        "mayForceTrigger": false,
        "timeoutMs": 5000
      }
    }
  },
  "config": {
    "agent": {
      "schema": {
        "type": "object",
        "dict": {
          "collect": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "auto",
                "meta": {
                  "description": "自动收集"
                }
              },
              {
                "type": "const",
                "value": "asked",
                "meta": {
                  "description": "被要求时收集"
                }
              },
              {
                "type": "const",
                "value": "off",
                "meta": {
                  "description": "不收集"
                }
              }
            ],
            "meta": {
              "description": "收集策略",
              "default": "auto",
              "hint": "自动收集：群里被不同的人发过的表情包会自动收进库里；智能体也可以把图交来收藏。"
            }
          },
          "range": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "all",
                "meta": {
                  "description": "所有智能体收集的"
                }
              },
              {
                "type": "const",
                "value": "own",
                "meta": {
                  "description": "仅自己收集的"
                }
              }
            ],
            "meta": {
              "description": "可用表情包",
              "default": "all"
            }
          },
          "frequency": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": "smart",
                "meta": {
                  "description": "智能判断"
                }
              },
              {
                "type": "const",
                "value": "often",
                "meta": {
                  "description": "频繁（约每 3 次回复）"
                }
              },
              {
                "type": "const",
                "value": "moderate",
                "meta": {
                  "description": "适中（约每 5 次回复）"
                }
              },
              {
                "type": "const",
                "value": "sometimes",
                "meta": {
                  "description": "偶尔（约每 10 次回复）"
                }
              },
              {
                "type": "const",
                "value": "rare",
                "meta": {
                  "description": "极少"
                }
              }
            ],
            "meta": {
              "description": "使用频率",
              "default": "smart"
            }
          },
          "previewImages": {
            "type": "union",
            "list": [
              {
                "type": "const",
                "value": 0,
                "meta": {
                  "description": "不提供"
                }
              },
              {
                "type": "const",
                "value": 2,
                "meta": {
                  "description": "2 张"
                }
              },
              {
                "type": "const",
                "value": 4,
                "meta": {
                  "description": "4 张"
                }
              },
              {
                "type": "const",
                "value": 6,
                "meta": {
                  "description": "6 张"
                }
              }
            ],
            "meta": {
              "description": "检索预览图数量",
              "default": 4,
              "hint": "检索结果附带的候选图片，供智能体核对内容。需要模型支持视觉。"
            }
          }
        }
      }
    }
  },
  "contributions": [
    {
      "kind": "tool",
      "name": "sticker_save",
      "description": "把当前频道中的一张图交给表情包库收藏"
    },
    {
      "kind": "tool",
      "name": "sticker_search",
      "description": "按想表达的情绪检索表情包，返回候选和预览图",
      "verificationInput": {
        "query": "开心"
      }
    },
    {
      "kind": "tool",
      "name": "sticker_use",
      "description": "取得可以发送的表情包图片"
    },
    {
      "kind": "tool",
      "name": "sticker_update",
      "description": "修正表情包的描述，或改为仅限来源频道"
    },
    {
      "kind": "tool",
      "name": "sticker_remove",
      "description": "将表情包移入回收站"
    },
    {
      "kind": "rpc",
      "method": "library.overview"
    },
    {
      "kind": "rpc",
      "method": "library.list"
    },
    {
      "kind": "rpc",
      "method": "library.update"
    },
    {
      "kind": "rpc",
      "method": "library.remove"
    },
    {
      "kind": "rpc",
      "method": "library.restore"
    },
    {
      "kind": "rpc",
      "method": "library.settings"
    },
    {
      "kind": "rpc",
      "method": "collect.status"
    },
    {
      "kind": "rpc",
      "method": "import.models"
    },
    {
      "kind": "rpc",
      "method": "import.start"
    },
    {
      "kind": "rpc",
      "method": "import.status"
    },
    {
      "kind": "rpc",
      "method": "import.cancel"
    },
    {
      "kind": "rpc",
      "method": "channel.get"
    },
    {
      "kind": "rpc",
      "method": "channel.set"
    },
    {
      "kind": "panel",
      "id": "channel",
      "anchor": "channel",
      "title": "表情包",
      "densities": ["compact", "full"]
    },
    {
      "kind": "host-page",
      "entryId": "library",
      "title": "表情包",
      "description": "浏览、整理和导入表情包",
      "icon": {
        "kind": "svg",
        "path": "assets/library.svg",
        "sha256": "3a238280dfa8efc3ad1dc4e6b2bcc58ea28f7c0c29e8b9950c7c2f54a6763dd2"
      },
      "objectPane": "hidden",
      "startPath": "",
      "rail": {
        "order": 60
      }
    }
  ]
}
