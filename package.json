{
  "name": "nekro-nxt-extensions",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "NekroNXT 官方种子扩展：开箱可用，也是扩展开发的示范与参考",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsx tools/pack.ts",
    "release:prepare": "tsx tools/pack.ts --bump",
    "verify": "tsx tools/verify.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "publish:community": "tsx tools/publish.ts"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@nekro-nxt/contracts": "file:vendor/nekro-nxt-contracts-0.2.0.tgz",
    "@nekro-nxt/extension-format": "0.1.0",
    "@nekro-nxt/extension-sdk": "file:vendor/nekro-nxt-extension-sdk-0.1.0.tgz",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "zod": "4.4.3"
  }
}
